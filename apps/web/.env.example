# Supabase (obtener en https://app.supabase.com -> Proyecto -> Configuración -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Secreto para firmar JWT efímeros (obtener en Supabase -> Configuración -> API -> JWT secret)
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# Opcional: URL del sitio en producción (para Supabase Auth redirect)
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
