# Supabase (obtener en https://app.supabase.com -> Proyecto -> Configuración -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable-aqui

# Secreto para firmar JWT efímeros (obtener en Supabase -> Configuración -> API -> JWT secret)
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# URL del sitio en producción (Supabase Auth redirect y extensión)
NEXT_PUBLIC_SITE_URL=https://marker.tu-subdominio.workers.dev
