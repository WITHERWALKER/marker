# Copia este archivo a .env.local y ajusta los valores.

# Supabase local (tras `supabase start` muestra estos valores):
#   API URL:      http://localhost:54321
#   anon key:     (la que imprime el comando)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplaza-por-tu-anon-key

# Secret con el que Supabase firma los JWT. En local lo imprime `supabase start`
# (JWT_SECRET); en la nube, Project Settings → API. Marker lo usa para emitir
# JWT efímeros (rol authenticated) a la API de tokens, sin service-role.
SUPABASE_JWT_SECRET=reemplaza-por-tu-jwt-secret
