{
  "name": "marker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @marker/web dev",
    "build": "pnpm --filter @marker/web build",
    "build:pages": "pnpm install && pnpm --filter @marker/web build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "wrangler": "^4.162.0"
  }
}
